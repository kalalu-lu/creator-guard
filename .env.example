# 复制这个文件为 .env，然后按需修改。
# 注意：.env 不要上传到公开仓库。

# ollama = 调用本地大模型；mock = 只用规则，不装模型也能测试
CG_LLM_BACKEND=ollama

# Ollama 默认地址
CG_OLLAMA_BASE_URL=http://127.0.0.1:11434

# 7B 是 Apache-2.0 许可，中文效果和显存占用比较平衡
# 低配电脑可改成 qwen2.5:1.5b-instruct，但判断质量会下降
CG_OLLAMA_MODEL=qwen2.5:7b-instruct

# 模型超时（秒）
CG_OLLAMA_TIMEOUT=120

# 评论统计窗口：5 天
CG_STATS_WINDOW_DAYS=5

# 本地数据保留天数
CG_RETENTION_DAYS=30

# 是否每小时检查一次是否有到期需要重新统计的评论区
CG_AUTO_STATS=true

# 私信单条最多送多少字给模型
CG_MAX_DM_CHARS=6000

# 单条评论最多送多少字给模型
CG_MAX_COMMENT_CHARS=800

# 日志级别：DEBUG / INFO / WARNING
CG_LOG_LEVEL=INFO
